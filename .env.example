NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase nguồn chỉ đọc. API đồng bộ chỉ gửi GET tới bảng orders nguồn.
SPEEGO_SOURCE_SUPABASE_URL=https://SOURCE_PROJECT.supabase.co
SPEEGO_SOURCE_SUPABASE_KEY=YOUR_SOURCE_PUBLISHABLE_KEY
SPEEGO_SYNC_FROM=2026-09-01
SPEEGO_SYNC_BEFORE=2026-10-01

# Nguồn SpeedGo: đăng nhập rồi chỉ gửi GET tới Firestore orders/users; không gọi API ghi dữ liệu.
SPEEDGO_SOURCE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
SPEEDGO_SOURCE_FIREBASE_PROJECT_ID=speedgo-os
SPEEDGO_SOURCE_EMAIL=YOUR_SPEEDGO_ADMIN_EMAIL
SPEEDGO_SOURCE_PASSWORD=YOUR_SPEEDGO_ADMIN_PASSWORD

# Chỉ đặt ở server/Vercel. Không dùng tiền tố NEXT_PUBLIC_ cho khóa OpenAI.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.4-mini

# Đăng nhập ChatGPT/Codex bằng device code. Tạo chuỗi bí mật ngẫu nhiên tối thiểu 32 ký tự.
CODEX_TOKEN_ENCRYPTION_KEY=GENERATE_A_RANDOM_32_BYTE_SECRET
CODEX_OAUTH_MODEL=gpt-5.5

# Chỉ dùng ở máy quản trị khi chạy npm run db:import. Không đưa key này lên client/Vercel.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
IMPORT_ADMIN_EMAIL=admin@hahoanpp.vn
IMPORT_ADMIN_PASSWORD=change-this-password
IMPORT_ADMIN_NAME=Quản trị Hà Hoà
